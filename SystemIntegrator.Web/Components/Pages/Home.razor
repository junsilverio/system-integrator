@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using SystemIntegrator.Web.Services
@inject IntegrationRepository Repository

<PageTitle>Dashboard</PageTitle>

<h1>API Health Dashboard</h1>
<p class="text-secondary">Real-time monitoring for configured API integrations.</p>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="smartadmin-card">
            <div class="metric-title">Total APIs</div>
            <div class="metric-value">@_statuses.Count</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="smartadmin-card">
            <div class="metric-title">Healthy</div>
            <div class="metric-value text-success">@_statuses.Count(x => x.Status == "Healthy")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="smartadmin-card">
            <div class="metric-title">Degraded</div>
            <div class="metric-value text-warning">@_statuses.Count(x => x.Status == "Degraded")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="smartadmin-card">
            <div class="metric-title">Down / Disabled</div>
            <div class="metric-value text-danger">@_statuses.Count(x => x.Status is "Down" or "Disabled")</div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="h5 mb-0">Current API Status</h2>
    <div class="d-flex align-items-center gap-2">
        <span class="text-secondary small">Last refresh: @_lastRefreshLocal.ToString("yyyy-MM-dd HH:mm:ss")</span>
        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="RefreshStatuses">Refresh</button>
    </div>
</div>

<div class="smartadmin-card">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>API Name</th>
                <th>Status</th>
                <th>Response Time</th>
                <th>Checked (UTC)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in _statuses)
            {
                <tr>
                    <td>@item.ApiName</td>
                    <td>
                        <span class="badge @StatusBadgeClass(item.Status)">@item.Status</span>
                    </td>
                    <td>@(item.Status == "Disabled" ? "-" : $"{item.ResponseTimeMs} ms")</td>
                    <td>@item.CheckedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<ApiHealthStatus> _statuses = [];
    private DateTime _lastRefreshLocal = DateTime.Now;
    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _refreshCancellation;

    protected override void OnInitialized()
    {
        RefreshStatuses();
        _refreshCancellation = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        _ = AutoRefreshAsync();
    }

    private async Task AutoRefreshAsync()
    {
        if (_refreshTimer is null || _refreshCancellation is null)
        {
            return;
        }

        try
        {
            while (await _refreshTimer.WaitForNextTickAsync(_refreshCancellation.Token))
            {
                await InvokeAsync(() =>
                {
                    RefreshStatuses();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void RefreshStatuses()
    {
        _statuses = Repository.GetApiHealthStatuses().ToList();
        _lastRefreshLocal = DateTime.Now;
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        "Healthy" => "bg-success",
        "Degraded" => "bg-warning text-dark",
        "Down" => "bg-danger",
        _ => "bg-secondary"
    };

    public void Dispose()
    {
        _refreshCancellation?.Cancel();
        _refreshCancellation?.Dispose();
        _refreshTimer?.Dispose();
    }
}
