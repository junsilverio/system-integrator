@page "/maintenance"
@rendermode InteractiveServer
@using SystemIntegrator.Web.Services
@inject IntegrationRepository Repository

<PageTitle>Maintenance</PageTitle>

<h1>API Configuration Maintenance</h1>
<p class="text-secondary">Add, update, disable, remove, and report API endpoint configurations.</p>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="smartadmin-card">
            <div class="metric-title">Total Configurations</div>
            <div class="metric-value">@_report.Total</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="smartadmin-card">
            <div class="metric-title">Enabled</div>
            <div class="metric-value text-success">@_report.Enabled</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="smartadmin-card">
            <div class="metric-title">Disabled</div>
            <div class="metric-value text-danger">@_report.Disabled</div>
        </div>
    </div>
</div>

<div class="smartadmin-card mb-4">
    <h2 class="h5">@(_editingId is null ? "Add API Configuration" : "Update API Configuration")</h2>

    <EditForm Model="_form" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">API Name</label>
                <InputText class="form-control" @bind-Value="_form.Name" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Base URL</label>
                <InputText class="form-control" @bind-Value="_form.BaseUrl" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Environment</label>
                <InputText class="form-control" @bind-Value="_form.Environment" />
            </div>
            <div class="col-md-3">
                <label class="form-label d-block">Status</label>
                <InputCheckbox class="form-check-input me-2" @bind-Value="_form.Enabled" /> Enabled
            </div>
            <div class="col-md-9 d-flex gap-2 align-items-end">
                <button type="submit" class="btn btn-primary">Save</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="ClearForm">Clear</button>
            </div>
        </div>
    </EditForm>
</div>

<div class="smartadmin-card">
    <h2 class="h5">Current API Configurations</h2>

    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>URL</th>
                <th>Environment</th>
                <th>Status</th>
                <th>Updated</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in _configs)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.BaseUrl</td>
                    <td>@item.Environment</td>
                    <td>@(item.Enabled ? "Enabled" : "Disabled")</td>
                    <td>@item.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="() => Edit(item)">Edit</button>
                        <button type="button" class="btn btn-sm btn-outline-warning me-1" @onclick="() => Toggle(item)">
                            @(item.Enabled ? "Disable" : "Enable")
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => Remove(item.Id)">Remove</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private ApiConfigurationReport _report = new(0, 0, 0);
    private List<ApiConfiguration> _configs = [];
    private ApiConfigurationForm _form = new();
    private Guid? _editingId;

    protected override void OnInitialized()
    {
        Reload();
    }

    private Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Name) || string.IsNullOrWhiteSpace(_form.BaseUrl) || string.IsNullOrWhiteSpace(_form.Environment))
        {
            return Task.CompletedTask;
        }

        Repository.UpsertApiConfiguration(new ApiConfigurationInput(
            _editingId,
            _form.Name,
            _form.BaseUrl,
            _form.Environment,
            _form.Enabled));

        ClearForm();
        Reload();
        return Task.CompletedTask;
    }

    private void Edit(ApiConfiguration config)
    {
        _editingId = config.Id;
        _form = new ApiConfigurationForm
        {
            Name = config.Name,
            BaseUrl = config.BaseUrl,
            Environment = config.Environment,
            Enabled = config.Enabled
        };
    }

    private void Toggle(ApiConfiguration config)
    {
        Repository.SetApiConfigurationEnabled(config.Id, !config.Enabled);
        Reload();
    }

    private void Remove(Guid id)
    {
        Repository.RemoveApiConfiguration(id);
        if (_editingId == id)
        {
            ClearForm();
        }

        Reload();
    }

    private void ClearForm()
    {
        _editingId = null;
        _form = new ApiConfigurationForm { Enabled = true };
    }

    private void Reload()
    {
        _configs = Repository.GetApiConfigurations().ToList();
        _report = Repository.GetApiConfigurationReport();
    }

    private sealed class ApiConfigurationForm
    {
        public string Name { get; set; } = string.Empty;
        public string BaseUrl { get; set; } = string.Empty;
        public string Environment { get; set; } = "Production";
        public bool Enabled { get; set; } = true;
    }
}
